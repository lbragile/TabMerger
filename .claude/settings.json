{
  "enabledMcpjsonServers": [
    "stripe",
    "playwright",
    "chrome-devtools"
  ],
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json,re; d=json.load(sys.stdin); p=d.get('file_path',''); blocked=bool(re.search(r'\\.env($|\\.)|pnpm-lock\\.yaml',p)); print('Blocked: '+p+' is a protected file — edit manually.',file=sys.stderr) if blocked else None; sys.exit(1 if blocked else 0)\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/tsc-check.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/test-check.py"
          }
        ]
      }
    ]
  }
}
