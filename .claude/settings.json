{
  "enabledMcpjsonServers": [
    "stripe",
    "playwright",
    "chrome-devtools"
  ],
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json,re; d=json.load(sys.stdin); p=d.get('file_path',''); blocked=bool(re.search(r'\\.env($|\\.)|pnpm-lock\\.yaml',p)); print('Blocked: '+p+' is a protected file — edit manually.',file=sys.stderr) if blocked else None; sys.exit(1 if blocked else 0)\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,os,subprocess,types; data=sys.stdin.buffer.read(); root=subprocess.run(['git','rev-parse','--show-toplevel'],capture_output=True,text=True).stdout.strip(); sys.stdin=__import__('io').TextIOWrapper(__import__('io').BytesIO(data)); exec(open(os.path.join(root,'.claude','hooks','tsc-check.py')).read())\""
          },
          {
            "type": "command",
            "command": "python3 -c \"import sys,os,subprocess,types; data=sys.stdin.buffer.read(); root=subprocess.run(['git','rev-parse','--show-toplevel'],capture_output=True,text=True).stdout.strip(); sys.stdin=__import__('io').TextIOWrapper(__import__('io').BytesIO(data)); exec(open(os.path.join(root,'.claude','hooks','test-check.py')).read())\""
          }
        ]
      }
    ]
  }
}
