# Environment files — never commit real secrets
.env.local
.env.*.local
.env
.env.test
.env.production
.env.beta

# direnv — local per-directory env (MCP credentials, etc.)
.envrc
.direnv/

# Claude Code local overrides (may contain API keys)
.claude/settings.local.json

# Claude Code session handoffs (local working notes, not project docs)
.claude/handoffs/

node_modules

coverage
build
dist

# Next.js
.next/
out/

# WXT / extension build outputs
.output/
.wxt/

# Turbopack / Turbo
.turbo/

# Vite
.vite/

# Python (Claude Code hook scripts under .claude/hooks/)
__pycache__/
*.pyc

# Cache
.eslintcache
.stylelintcache
*.tsbuildinfo
.tokensave

# Supabase
supabase/.temp/
supabase/.branches/

# Sentry
.sentryclirc
.sentry/
packages/web/.next/static/chunks/*.js.map

# Test outputs
coverage/
playwright-report/
blob-report/
test-results/
.vitest-cache/
# JUnit files written for Codecov's Tests tab (CI only, see docs/CODECOV.md)
junit-*.xml

# Playwright MCP artifacts
.playwright-mcp/

# Ephemeral E2E auth session (Supabase session cookie + test user id)
packages/web/e2e/.auth/

# Stray Playwright/Chromium user-data-dir profiles (path-mangling artifact
# from temp-dir launch options landing in the repo instead of the OS temp dir)
**/*pw-debug-data*/
*.zip
*.webm
*.png
!public/**/*.png
!packages/extension/src/**/*.png
!packages/web/public/**/*.png
!packages/web/app/**/*.png
# Playwright visual regression baselines — committed intentionally, update via --update-snapshots
!packages/web/e2e/**/*-snapshots/**/*.png
!packages/extension/e2e/**/*-snapshots/**/*.png
.vercel

# Private local notes: kept on disk and backed up to the private repo, never committed here.
# Agent-memory notes are private when named feedback_*, project_* or user_*; MEMORY.private.md
# is the private index. Everything else under .claude/agent-memory/ is public and reviewed.
.claude/plans/
TODO.md
.agents/
.claude/agent-memory/**/feedback_*
.claude/agent-memory/**/project_*
.claude/agent-memory/**/user_*
.claude/agent-memory/**/MEMORY.private.md
# Public learnings are never private, even if a word in the name looks like a prefix.
!.claude/agent-memory/**/learnings_*
