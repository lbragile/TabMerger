# ponytail: escape hatch for the demo-video recording pipeline only — never set in real builds.
# Loaded via `wxt build -m demo` (see package.json "build:extension:demo").
# Exposes the hidden "Demo Mode" button in Settings so packages/demo/record.ts can reach it
# in a production-mode extension artifact, where import.meta.env.DEV is false.
VITE_DEMO_BUILD=true
