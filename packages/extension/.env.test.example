# Copy to .env.test and fill in with a Supabase *branch* (throwaway/preview) project's
# credentials — NEVER the production project. Vitest auto-loads `.env.test` because it
# runs in `test` mode (Vite's default env-file convention), so no extra config is needed.
#
# Provisioning (requires Supabase MCP tools or `supabase` CLI with a linked project):
#   mcp: create_branch (project_ref from supabase/.temp/project-ref) -> get_project_url / get_publishable_keys
#   cli: supabase branches create tabmerger-integration-tests
#
# TEST_USER_EMAIL/PASSWORD must belong to a real user seeded on the branch (via
# supabase.auth.admin.createUser with the branch's service role key, OUTSIDE of this repo/tests —
# never commit a service role key). RLS policies (see supabase/migrations/002_rls_policies.sql)
# require auth.uid() = user_id, so the integration tests sign in as this user to get a real session.

VITE_SUPABASE_URL=https://your-branch-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

TEST_USER_EMAIL=your@email.com
TEST_USER_PASSWORD=replace_with_a_real_test_password
