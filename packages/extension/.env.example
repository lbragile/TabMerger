VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WEB_APP_URL= # dev: http://localhost:3000, prod: set in .env.production (currently https://tabmerger.vercel.app)
VITE_STRIPE_PUBLISHABLE_KEY=
# Sentry error tracking — leave empty in dev; set in production .env.local
VITE_SENTRY_DSN=
# PostHog HTTP Capture API — leave empty in dev; set in production .env.local.
# Event capture only, no JS SDK (MV3 popup CSP blocks its CDN-loaded extensions,
# so session replay is not available through this integration).
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
