VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WEB_APP_URL= # dev: http://localhost:3000, prod: set in .env.production (currently https://tabmerger.vercel.app)
VITE_STRIPE_PUBLISHABLE_KEY=
# Sentry error tracking — leave empty in dev; set in production .env.local
VITE_SENTRY_DSN=
# GA4 Measurement Protocol — leave empty in dev; set in production .env.local
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA4_API_SECRET=your_api_secret
