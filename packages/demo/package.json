{
  "name": "@tabmerger/demo",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "description": "Playwright recording + Remotion rendering pipeline for the TabMerger walkthrough video",
  "scripts": {
    "studio": "remotion studio remotion/Root.tsx",
    "record:dark": "tsx record.ts dark",
    "record:light": "tsx record.ts light",
    "render:dark": "remotion render remotion/Root.tsx WalkthroughDemoDark out/tabmerger-demo-dark.mp4 --crf=16",
    "render:light": "remotion render remotion/Root.tsx WalkthroughDemoLight out/tabmerger-demo-light.mp4 --crf=16",
    "render:promo-dark": "remotion render remotion/Root.tsx PromoDark out/tabmerger-promo-dark.mp4 --crf=16",
    "render:promo-light": "remotion render remotion/Root.tsx PromoLight out/tabmerger-promo-light.mp4 --crf=16",
    "render:promo-dark-vertical": "remotion render remotion/Root.tsx PromoDarkVertical out/tabmerger-promo-dark-vertical.mp4 --crf=16",
    "render:promo-light-vertical": "remotion render remotion/Root.tsx PromoLightVertical out/tabmerger-promo-light-vertical.mp4 --crf=16",
    "render:tour-dark": "remotion render remotion/Root.tsx TourDark out/tour/tabmerger-tour-dark.mp4 --crf=16",
    "render:tour-light": "remotion render remotion/Root.tsx TourLight out/tour/tabmerger-tour-light.mp4 --crf=16",
    "render:tour-dark-silent": "remotion render remotion/Root.tsx TourDark out/tour/tabmerger-tour-dark-silent.mp4 --crf=16 --props=\"{\\\"audio\\\":false}\"",
    "render:tour-light-silent": "remotion render remotion/Root.tsx TourLight out/tour/tabmerger-tour-light-silent.mp4 --crf=16 --props=\"{\\\"audio\\\":false}\"",
    "audio:tour": "tsx generate-tour-audio.ts",
    "audio:chart": "tsx render-tour-audio-chart.ts",
    "render:tour-scene": "tsx render-tour-scene.ts",
    "render:tour-thumbnail": "tsx render-tour-thumbnail.ts",
    "record:tour": "tsx record-tour.ts",
    "record:tour-window": "tsx record-tour-window.ts",
    "record:tour-organise-tabs": "tsx record-tour-organise-tabs.ts",
    "record:tour-name-and-note": "tsx record-tour-name-and-note.ts",
    "record:tour-find-a-tab": "tsx record-tour-find-a-tab.ts",
    "record:tour-restore-group": "tsx record-tour-restore-group.ts",
    "record:tour-share-group": "tsx record-tour-share-group.ts",
    "record:tour-sync-devices": "tsx record-tour-sync-devices.ts",
    "tour-assets": "tsx capture-tour-assets.ts",
    "screenshots": "tsx screenshots.ts",
    "beta-shots": "tsx beta-screenshots.ts",
    "store-assets": "tsx render-store-assets.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@remotion/bundler": "^4.0.490",
    "@remotion/cli": "^4.0.490",
    "@remotion/player": "^4.0.490",
    "@remotion/renderer": "^4.0.490",
    "remotion": "^4.0.490",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
