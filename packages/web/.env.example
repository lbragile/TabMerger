NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_AI_MONTHLY_PRICE_ID=
STRIPE_PRO_AI_YEARLY_PRICE_ID=
# One-time (mode: payment) AI credit pack top-up — $2.99 for +50 AI calls, expires month-end.
# Create as a one-time Stripe Price (not recurring) alongside the subscription prices above.
STRIPE_AI_CREDIT_PACK_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ANTHROPIC_API_KEY=
# Resend — transactional email (contact form). No custom domain configured;
# sends from Resend's default onboarding@resend.dev sender.
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Published Chrome Web Store extension ID, baked into the extension build via CHROME_EXTENSION_ID.
# Used by useExtensionInstalled.ts to ping the right extension via externally_connectable.
# Falls back to the local dev/unpacked ID (ogadhgghhdbaohdcajfakeogcamicdkm) when unset.
# Real published ID (see the install link in OnboardingChecklist.tsx): inmiajapbpafmhjleiebcamfhkfnlgoc
# Set this for the PRODUCTION web deployment (Vercel env var) only — leave unset in .env.local,
# since the local unpacked dev extension's real runtime ID is the dev ID above, not this one.
NEXT_PUBLIC_CHROME_EXTENSION_ID=
# Published Edge Add-ons store extension ID. Edge installs from the Edge Add-ons store get a
# DIFFERENT id from the Chrome Web Store build of the same code — this lets the web app reach
# those installs too (Edge-via-Chrome-Web-Store installs already work via the ID above).
# See EXTENSION_IDS in lib/extensionId.ts / lib/extensionMessaging.ts's sendToExtension, which
# tries each configured ID in order until one answers.
NEXT_PUBLIC_EDGE_EXTENSION_ID=
# Sentry error tracking (DSN isn't secret — NEXT_PUBLIC_ so it reaches the browser bundle too)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Source map upload — never commit the real value; set in CI via GitHub secret SENTRY_AUTH_TOKEN
SENTRY_AUTH_TOKEN=
# Google Analytics 4 — analytics.google.com → Admin → Data Streams → Measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GA4 Measurement Protocol API secret (server-only, NOT NEXT_PUBLIC_) — used by the Stripe
# webhook to fire checkout_completed events. Create at GA4 Admin > Data Streams > Measurement Protocol API secrets.
GA_API_SECRET=

# GA4 for the browser EXTENSION's own property/data stream — distinct from the web app's
# NEXT_PUBLIC_GA_MEASUREMENT_ID/GA_API_SECRET above. Used by app/api/track/route.ts, which the
# extension POSTs events to (rather than calling google-analytics.com directly) so these values
# never ship inside the extension bundle.
GA_EXTENSION_MEASUREMENT_ID=G-XXXXXXXXXX
GA_EXTENSION_API_SECRET=your_api_secret
# Public base URL of the Vercel Blob store CI uploads the self-distributed (unlisted) Firefox
# beta build to, e.g. https://<id>.public.blob.vercel-storage.com — not a secret, just
# environment-specific. Set only on the Preview deployment (see docs/PUBLISHING.md); when unset,
# /firefox-beta/* isn't rewritten and the /beta page shows a "coming soon" line instead of the
# install section.
FIREFOX_BETA_BLOB_BASE_URL=
