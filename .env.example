# =============================================================================
# TabMerger 2.0 — Environment Variables Reference
# =============================================================================
# Copy this file to packages/web/.env.local for local Next.js development.
# The extension reads its env vars via WXT's built-in env loading (place a
# .env file in packages/extension/ for local dev).
# Never commit real secrets — this file documents the shape only.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE — https://supabase.com/dashboard/project/<project>/settings/api
# Required by: packages/extension, packages/web
# -----------------------------------------------------------------------------

# Your Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon/public key (safe to expose to the browser; subject to RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Supabase service-role key — NEVER expose to the browser or extension
# Used only by server-side code (Next.js API routes, Edge Functions)
# Found at: Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret — used for verifying tokens server-side
# Found at: Dashboard > Settings > API > JWT Settings
SUPABASE_JWT_SECRET=super-secret-jwt-token-for-local-dev


# -----------------------------------------------------------------------------
# STRIPE — https://dashboard.stripe.com/apikeys
# Required by: packages/web (server-side only)
# -----------------------------------------------------------------------------

# Stripe publishable key (safe to expose to the browser)
# Found at: Dashboard > Developers > API keys > Publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe secret key — NEVER expose to the browser
# Found at: Dashboard > Developers > API keys > Secret key
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret — used to verify webhook payloads from Stripe
# Found at: Dashboard > Developers > Webhooks > Signing secret
# For local dev, use `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs for subscription tiers
# Found at: Dashboard > Products > (select product) > Pricing
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_PRO_AI_MONTHLY=price_...
STRIPE_PRICE_PRO_AI_YEARLY=price_...


# -----------------------------------------------------------------------------
# ANTHROPIC — https://console.anthropic.com/settings/keys
# Required by: packages/web (AI API route handlers only, server-side)
# -----------------------------------------------------------------------------

# Anthropic API key for AI features (pro_ai tier)
# Found at: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...


# -----------------------------------------------------------------------------
# CHROME WEB STORE — CI/CD (GitHub Actions secrets)
# Required by: .github/workflows/publish.yml
# -----------------------------------------------------------------------------

# Your published extension's unique ID
# Found at: Chrome Web Store Developer Dashboard > Extension > Extension ID
CHROME_EXTENSION_ID=

# OAuth 2.0 Client ID for the Chrome Web Store API
# Guide: https://developer.chrome.com/docs/webstore/using-api/
CHROME_CLIENT_ID=

# OAuth 2.0 Client Secret
CHROME_CLIENT_SECRET=

# Long-lived refresh token obtained via the OAuth flow
CHROME_REFRESH_TOKEN=


# -----------------------------------------------------------------------------
# FIREFOX ADD-ONS — CI/CD (GitHub Actions secrets)
# Required by: .github/workflows/publish.yml
# -----------------------------------------------------------------------------

# Firefox AMO (addons.mozilla.org) API key
# Found at: https://addons.mozilla.org/en-US/developers/addon/api/key/
FIREFOX_API_KEY=user:...

# Firefox AMO API secret (paired with the key above)
FIREFOX_API_SECRET=


# -----------------------------------------------------------------------------
# MICROSOFT EDGE ADD-ONS — CI/CD (GitHub Actions secrets)
# Required by: .github/workflows/publish.yml
# -----------------------------------------------------------------------------

# Your Edge extension's product ID
# Found at: Microsoft Partner Center > Edge extensions > your extension
EDGE_PRODUCT_ID=

# Short-lived access token obtained from the Edge Add-ons API OAuth flow
# Refresh this token in CI using the CLIENT_ID/SECRET/TENANT_ID below
EDGE_ACCESS_TOKEN=

# Azure AD / Microsoft identity credentials for token refresh
# Guide: https://learn.microsoft.com/en-us/microsoft-edge/extensions-chromium/publish/api/using-addons-api
EDGE_CLIENT_ID=
EDGE_CLIENT_SECRET=
EDGE_TENANT_ID=


# -----------------------------------------------------------------------------
# VERCEL — CI/CD (GitHub Actions secrets)
# Required by: .github/workflows/deploy-web.yml
# -----------------------------------------------------------------------------

# Vercel personal access token
# Found at: vercel.com/account/tokens
VERCEL_TOKEN=

# Vercel org/team ID
# Found at: vercel.com/<team>/settings > General > Team ID
VERCEL_ORG_ID=

# Vercel project ID for packages/web
# Found at: vercel.com/<team>/<project>/settings > General > Project ID
VERCEL_PROJECT_ID=


# -----------------------------------------------------------------------------
# LOCAL SUPABASE (Supabase CLI / self-hosted dev)
# These are auto-set by `supabase start` — listed here for reference
# -----------------------------------------------------------------------------

# Supabase local dev API URL (default)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local anon key printed by `supabase start`
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Local service-role key printed by `supabase start`
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
